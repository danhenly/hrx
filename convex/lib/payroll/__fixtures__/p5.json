{
  "description": "thirteenth.ts + loans.ts + the engine's P5 lines (accrual, payout split, loan priority/shortfall, final pay). Money in centavos.",
  "cases": [
    {
      "name": "accrual for a full cutoff is 1/12 of the basic earned",
      "kind": "accrual",
      "input": {
        "basicEarnedCentavos": 841188
      },
      "expect": {
        "centavos": 70099
      }
    },
    {
      "name": "24 rounded cutoffs land exactly on 1/12 of the annual basic (round-half-up per period)",
      "kind": "accrualYear",
      "input": {
        "perCutoffCentavos": 841188,
        "cutoffs": 24
      },
      "expect": {
        "totalCentavos": 1682376
      }
    },
    {
      "name": "per-period rounding stays within 12 centavos of the exact figure (the stated rule)",
      "kind": "accrualYearBound",
      "input": {
        "perCutoffCentavos": 100,
        "cutoffs": 24
      },
      "expect": {
        "within12Cents": true
      }
    },
    {
      "name": "13th month inside the \u20b190,000 ceiling is fully exempt",
      "kind": "payoutSplit",
      "input": {
        "accruedCentavos": 1682376,
        "paidCentavos": 0,
        "exemptUsedCentavos": 0,
        "ceilingCentavos": 9000000
      },
      "expect": {
        "totalCentavos": 1682376,
        "exemptCentavos": 1682376,
        "taxableCentavos": 0
      }
    },
    {
      "name": "an employee who already used \u20b180,000 of the ceiling has \u20b110,000 exempt and the rest TAXABLE",
      "kind": "payoutSplit",
      "input": {
        "accruedCentavos": 5000000,
        "paidCentavos": 0,
        "exemptUsedCentavos": 8000000,
        "ceilingCentavos": 9000000
      },
      "expect": {
        "totalCentavos": 5000000,
        "exemptCentavos": 1000000,
        "taxableCentavos": 4000000
      }
    },
    {
      "name": "a payout releases only what is not already paid",
      "kind": "payoutSplit",
      "input": {
        "accruedCentavos": 2000000,
        "paidCentavos": 1500000,
        "exemptUsedCentavos": 0,
        "ceilingCentavos": 9000000
      },
      "expect": {
        "totalCentavos": 500000,
        "exemptCentavos": 500000
      }
    },
    {
      "name": "10 equal instalments of a \u20b130,000 SSS salary loan",
      "kind": "instalments",
      "input": {
        "principalCentavos": 3000000,
        "termMonths": 10
      },
      "expect": {
        "first": 300000,
        "count": 10,
        "last": 300000,
        "sum": 3000000
      }
    },
    {
      "name": "an odd principal puts the residue on the LAST instalment",
      "kind": "instalments",
      "input": {
        "principalCentavos": 3000001,
        "termMonths": 10
      },
      "expect": {
        "first": 300000,
        "count": 10,
        "last": 300001,
        "sum": 3000001
      }
    },
    {
      "name": "loans pay in priority order: SSS before Pag-IBIG before a company loan",
      "kind": "planLoans",
      "input": {
        "availableCentavos": 500000,
        "loans": [
          {
            "id": "c1",
            "type": "company",
            "balanceCentavos": 400000,
            "amortisationCentavos": 100000
          },
          {
            "id": "p1",
            "type": "pagibig",
            "balanceCentavos": 50000,
            "amortisationCentavos": 50000
          },
          {
            "id": "s1",
            "type": "sss",
            "balanceCentavos": 300000,
            "amortisationCentavos": 150000
          }
        ]
      },
      "expect": {
        "order": [
          "s1",
          "p1",
          "c1"
        ],
        "paid": 300000,
        "remaining": 200000
      }
    },
    {
      "name": "a schedule that would take net pay below zero BLOCKS the payslip (D9)",
      "kind": "planLoans",
      "input": {
        "availableCentavos": 500000,
        "loans": [
          {
            "id": "s1",
            "type": "sss",
