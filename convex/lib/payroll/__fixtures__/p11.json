{
  "description": "P11 opening balances: the year-to-date the old system paid must reach the 2316, and a bad row must be refused",
  "cases": [
    {
      "name": "opening gross, taxable and withheld are added to the register",
      "kind": "opening",
      "input": {
        "op": "merge",
        "email": "a@x.ph",
        "gross": 120000,
        "taxable": 100000,
        "taxWithheld": 8000,
        "thirteenthMonth": 0,
        "registerGross": 5000000,
        "registerNonTaxable": 0,
        "registerTaxable": 5000000,
        "registerWithheld": 40000
      },
      "expect": {
        "gross": 17000000,
        "taxable": 15000000,
        "withheld": 840000
      }
    },
    {
      "name": "opening 13th month consumes the ceiling first, and the excess becomes taxable",
      "kind": "opening",
      "input": {
        "op": "merge",
        "email": "a@x.ph",
        "gross": 300000,
        "taxable": 200000,
        "taxWithheld": 0,
        "thirteenthMonth": 100000,
        "registerGross": 0,
        "registerNonTaxable": 0,
        "registerTaxable": 0,
        "registerWithheld": 0,
        "ceiling": 9000000
      },
      "expect": {
        "openingExempt": 9000000,
        "openingTaxable13": 1000000,
        "nonTaxable": 9000000
      }
    },
    {
      "name": "a 13th month inside the ceiling is entirely exempt",
      "kind": "opening",
      "input": {
        "op": "merge",
        "email": "a@x.ph",
        "gross": 200000,
        "taxable": 200000,
        "taxWithheld": 0,
        "thirteenthMonth": 50000,
        "registerGross": 0,
        "registerNonTaxable": 0,
        "registerTaxable": 0,
        "registerWithheld": 0,
        "ceiling": 9000000
      },
      "expect": {
        "openingExempt": 5000000,
        "openingTaxable13": 0
      }
    },
    {
      "name": "a negative amount is refused",
      "kind": "opening",
      "input": {
        "op": "validate",
        "email": "a@x.ph",
        "gross": -1,
        "taxable": 0,
        "taxWithheld": 0,
        "thirteenthMonth": 0
      },
      "expect": {
        "ok": false,
        "errors": 1
      }
    },
    {
      "name": "taxable above gross is refused",
      "kind": "opening",
      "input": {
        "op": "validate",
        "email": "a@x.ph",
        "gross": 100,
        "taxable": 200,
        "taxWithheld": 0,
        "thirteenthMonth": 0
      },
      "expect": {
        "ok": false,
        "errors": 1
      }
    },
    {
      "name": "a row with no identifier is refused",
      "kind": "opening",
      "input": {
        "op": "validate",
        "gross": 100,
        "taxable": 100,
        "taxWithheld": 0,
        "thirteenthMonth": 0
      },
      "expect": {
        "ok": false,
        "errors": 1
      }
    },
    {
      "name": "a clean row validates",
      "kind": "opening",
      "input": {
        "op": "validate",
        "email": "a@x.ph",
        "gross": 100,
        "taxable": 80,
        "taxWithheld": 5,
        "thirteenthMonth": 10
      },
      "expect": {
        "ok": true,
        "errors": 0
      }
    },
    {
      "name": "re-importing the same 13th month figure twice leaves the ledger unchanged",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 0,
        "imports": [
          50000,
          50000
        ]
      },
      "expect": {
        "paid": 50000,
        "exemptUsed": 50000,
        "afterFirstPaid": 50000,
        "afterFirstExempt": 50000
      }
    },
    {
      "name": "a corrected 13th month moves the ledger instead of stacking on the old figure",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 50000,
        "imports": [
          40000
        ],
        "startPaid": 50000,
        "startExemptUsed": 50000
      },
      "expect": {
        "paid": 40000,
        "exemptUsed": 40000
      }
    },
    {
      "name": "an opening 13th month above the ceiling consumes only the ceiling",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 0,
        "imports": [
          100000
        ]
      },
      "expect": {
        "paid": 100000,
        "exemptUsed": 90000
      }
    },
    {
      "name": "lowering a figure that still sits above the ceiling frees no exempt room",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 100000,
        "imports": [
          95000
        ],
        "startPaid": 100000,
        "startExemptUsed": 90000
      },
      "expect": {
        "paid": 95000,
        "exemptUsed": 90000
      }
    },
    {
      "name": "dropping below the ceiling claws the exempt usage back",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 100000,
        "imports": [
          60000
        ],
        "startPaid": 100000,
        "startExemptUsed": 90000
      },
      "expect": {
        "paid": 60000,
        "exemptUsed": 60000
      }
    },
    {
      "name": "deleting the opening row reverses only its share and keeps the register's payout",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 50000,
        "imports": [
          0
        ],
        "startPaid": 120000,
        "startExemptUsed": 90000
      },
      "expect": {
        "paid": 70000,
        "exemptUsed": 40000
      }
    },
    {
      "name": "a reversal never drives the ledger negative",
      "kind": "opening",
      "input": {
        "op": "ledgerImport",
        "startOpening": 50000,
        "imports": [
          0
        ]
      },
      "expect": {
        "paid": 0,
        "exemptUsed": 0
      }
    }
  ]
}