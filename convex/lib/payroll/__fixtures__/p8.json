{
  "description": "P8 leave: accrual is a real balance, and only a convertible type pays out",
  "cases": [
    {
      "name": "SIL accrues 5/12 of a day per period",
      "kind": "leave",
      "input": {
        "op": "accrual",
        "type": "SIL",
        "serviceMonths": 24
      },
      "expect": {
        "days": 0.4167
      }
    },
    {
      "name": "nothing accrues before the minimum service (Art. 95)",
      "kind": "leave",
      "input": {
        "op": "accrual",
        "type": "SIL",
        "serviceMonths": 6
      },
      "expect": {
        "days": 0
      }
    },
    {
      "name": "a 12-period year totals the entitlement exactly",
      "kind": "leave",
      "input": {
        "op": "yearTotal",
        "type": "SIL",
        "periods": 12,
        "serviceMonths": 36
      },
      "expect": {
        "days": 5
      }
    },
    {
      "name": "VL accrues 10/12 and also totals exactly",
      "kind": "leave",
      "input": {
        "op": "yearTotal",
        "type": "VL",
        "periods": 12,
        "serviceMonths": 3
      },
      "expect": {
        "days": 10
      }
    },
    {
      "name": "a non-accruing type (maternity) never accrues",
      "kind": "leave",
      "input": {
        "op": "accrual",
        "type": "MAT",
        "serviceMonths": 60
      },
      "expect": {
        "days": 0
      }
    },
    {
      "name": "balance is accrued minus used plus adjustments",
      "kind": "leave",
      "input": {
        "op": "balance",
        "accrued": 10,
        "used": 3.5,
        "adjusted": -0.5
      },
      "expect": {
        "days": 6
      }
    },
    {
      "name": "only a convertible type converts at separation",
      "kind": "leave",
      "input": {
        "op": "convert",
        "type": "SIL",
        "balance": 7,
        "dailyCentavos": 64500
      },
      "expect": {
        "centavos": 451500
      }
    },
    {
      "name": "a non-convertible balance pays nothing",
      "kind": "leave",
      "input": {
        "op": "convert",
        "type": "VL",
        "balance": 10,
        "dailyCentavos": 64500
      },
      "expect": {
        "centavos": 0
      }
    },
    {
      "name": "a negative balance converts to zero, not to a debt",
      "kind": "leave",
      "input": {
        "op": "convert",
        "type": "SIL",
        "balance": -2,
        "dailyCentavos": 64500
      },
      "expect": {
        "centavos": 0
      }
    },
    {
      "name": "control: without leave the window still books absences (6 scheduled days)",
      "kind": "computePayslip",
      "input": {
        "terms": {
          "payType": "monthly",
          "basicRate": 16823.75,
          "dailyRateBasis": "313",
          "workWeek": "6_day",
          "statutoryBasis": "basic",
          "allowances": []
        },
        "period": {
          "start": "2026-11-02",
          "end": "2026-11-09"
        },
        "entries": [],
        "tables": {},
        "cutoffIndex": 0,
        "deminimis": {}
      },
      "expect": {
        "absentDays": 6
      }
    },
    {
      "name": "three paid leave days remove exactly three absences",
      "kind": "computePayslip",
      "input": {
        "terms": {
          "payType": "monthly",
          "basicRate": 16823.75,
          "dailyRateBasis": "313",
          "workWeek": "6_day",
          "statutoryBasis": "basic",
          "allowances": []
        },
        "period": {
          "start": "2026-11-02",
          "end": "2026-11-09"
        },
        "entries": [],
        "tables": {},
        "cutoffIndex": 0,
        "deminimis": {},
        "leave": {
          "paidDates": [
            "2026-11-02",
            "2026-11-03",
            "2026-11-04"
          ]
        }
      },
      "expect": {
        "absentDays": 4
      }
    },
    {
      "name": "a paid leave day still books no ABSENCE for itself and no night differential",
      "kind": "computePayslip",
      "input": {
        "terms": {
          "payType": "monthly",
          "basicRate": 16823.75,
          "dailyRateBasis": "313",
          "workWeek": "6_day",
          "statutoryBasis": "basic",
          "allowances": []
        },
        "period": {
          "start": "2026-11-02",
          "end": "2026-11-09"
        },
        "entries": [],
        "tables": {},
        "cutoffIndex": 0,
        "deminimis": {},
        "leave": {
          "paidDates": [
            "2026-11-02",
            "2026-11-03",
            "2026-11-04",
            "2026-11-05",
            "2026-11-06",
            "2026-11-07",
            "2026-11-09"
          ]
        }
      },
      "expect": {
        "absentDays": 0
      }
    }
  ]
}